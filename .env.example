# Copy to .env.local for local development. Never commit real values.

# MongoDB Atlas connection string (a replica set; Atlas clusters are).
# Local development can use any replica set, e.g. mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=datsudoku

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional; the Google button appears only when both are set).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouDoSudoku API key (server-side only). Without it, puzzles come from the
# verified internal generator.
YOUDOSUDOKU_API_KEY=
